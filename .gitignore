# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
spark_ex-*.tar

# Spark distribution for integration tests (downloaded separately).
/test/spark-4.1.1-bin-hadoop3-connect/

# uv / Python virtualenv for spark_server
/test/spark_server/.venv/
spark-warehouse

# ElixirLS / editor caches
/.elixir_ls/

# Claude Code working directory
/.claude/

# Dialyzer PLT cache
/priv/plts/

# Local audit / planning / working notes — not part of the published package
/BUGS_*.txt
/BUGS_*.md
/REV_*.md
/CHECKLIST.md
/CHECKLIST_PROGRESS.md
/checklist/
/CODEGEN_MACRO.md
/EXPLORATORY_TESTS.md
/EXPLORER_*.md
/GRPC_CRASH.md
/NO_SERIALIZED_RPC.md
/PLAN_ID_WITH_REL.md
/README_TODO.md
/ROW_COLLECTION.md
/TO_LOCAL_ITERATOR.md
/ARROW_PANIC.md
